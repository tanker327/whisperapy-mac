# Copy to .env and adjust. Every value below is the built-in default, so an
# empty .env behaves exactly the same as this file.

# --- App
APP_NAME=whisperapy-mac
DEBUG=false

# --- Security
# Set to require `Authorization: Bearer <key>` or `X-API-Key: <key>` on /api/v1.
# Leave empty for an open server (localhost use only).
API_KEY=
# JSON list of allowed browser origins. Empty disables CORS entirely.
CORS_ORIGINS=[]
# Let /api/v1/transcribe/url fetch loopback / LAN / link-local addresses.
ALLOW_PRIVATE_URLS=false

# --- Logging
LOG_FORMAT=text            # text | json
LOG_FILE=                  # e.g. /var/log/whisperapy/app.log (rotating)
LOG_ROTATION=50 MB
LOG_RETENTION=14 days

# --- Models
MODEL_REPO=mlx-community/whisper-large-v3-turbo
EMBEDDING_MODEL_REPO=mlx-community/Qwen3-Embedding-4B-4bit-DWQ
EMBEDDING_MAX_TOKENS=8192  # longer inputs -> 422, or cut when EMBEDDING_TRUNCATE=true
EMBEDDING_TRUNCATE=false
EMBEDDING_MAX_BATCH=2048   # max strings per request
EMBEDDING_BATCH_SIZE=32    # strings per GPU forward pass

# --- Concurrency: one GPU job at a time; extras wait briefly then get 503 + Retry-After
MAX_QUEUED_JOBS=1
QUEUE_WAIT_SECONDS=15
TRANSCRIBE_SPEED_FACTOR=8      # x real-time, drives Retry-After for transcription
EMBED_TOKENS_PER_SECOND=2000   # drives Retry-After while an embed job runs

# --- Files
MAX_FILE_SIZE_MB=1500
TEMP_DIR=/tmp/whisperapy
TEMP_MAX_AGE_HOURS=6           # stale temp files older than this are swept at startup
FFMPEG_TIMEOUT_SECONDS=120     # floor ...
FFMPEG_TIMEOUT_SECONDS_PER_MB=0.5  # ... plus this much per MB of input

# --- URL downloads
DOWNLOAD_CONNECT_TIMEOUT=15
DOWNLOAD_READ_TIMEOUT=120
